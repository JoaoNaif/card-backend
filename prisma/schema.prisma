// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum Ranking {
  DISCRETO
  CONTINUO
  DIFERENCIAVEL
  NAO_LINEAR
  SINGULAR
  DIVERGENTE
  CAOTICO
}

enum Pillar {
  MATERIAL
  VETORIAL
  BIOLOGICA
  PSIQUICA
  FUNDAMENTAL
}

enum StatType {
  HP
  ATK
  DEF
  SPD
}

enum BonusType {
  PERCENT
  FLAT
}

enum TargetType {
  SINGLE_ENEMY
  AOE_ENEMIES
  SINGLE_ALLY
  ALL_ALLIES
  SELF
}

enum BattleMode {
  AUTO
  PVE
  PVP
}

enum BattleStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  userRole     UserRole    @default(USER)
  characters   Character[]
  battleTeams  BattleTeam[]
  createdAt    DateTime    @default(now())
}

model Trait {
  id                   String                @id @default(cuid())
  name                 String                @unique
  description          String
  characters           Character[]
  skills               Skill[]
  battleFieldModifiers BattleFieldModifier[]
  createdAt            DateTime              @default(now())
}

model Power {
  id                  String           @id @default(cuid())
  name                String           @unique
  description         String
  pillar              Pillar
  canAwaken           Boolean          @default(false)
  isAwakened          Boolean          @default(false)
  skills              Skill[]
  primaryCharacters   Character[]      @relation("PrimaryPower")
  secondaryCharacters Character[]      @relation("SecondaryPower")
  awakenedCharacters  Character[]      @relation("AwakenedPower")
  awakeningTargets    PowerAwakening[] @relation("BaseAwakening")
  awakeningSourceOf   PowerAwakening[] @relation("AwakenedResult")
  createdAt           DateTime         @default(now())
}

model PowerAwakening {
  id              String @id @default(cuid())
  basePowerId     String
  awakenedPowerId String
  basePower       Power  @relation("BaseAwakening", fields: [basePowerId], references: [id])
  awakenedPower   Power  @relation("AwakenedResult", fields: [awakenedPowerId], references: [id])

  @@unique([basePowerId, awakenedPowerId])
}

model Skill {
  id                   String           @id @default(cuid())
  name                 String           @unique
  description          String
  limitation           String
  cooldownTurns        Int              @default(0)
  debuffStat           StatType
  debuffValue          Float
  debuffDuration       Int
  targetType           TargetType       @default(SINGLE_ENEMY)
  damageMultiplier     Float            @default(0.0)
  healMultiplier       Float            @default(0.0)
  targetEffectStat     StatType?
  targetEffectValue    Float?
  targetEffectDuration Int?
  minLevel             Int
  powerId              String
  appliesBattleFieldId String?
  fieldDuration        Int?
  power                Power            @relation(fields: [powerId], references: [id])
  appliesBattleField   BattleField?     @relation(fields: [appliesBattleFieldId], references: [id])
  requiredTraits       Trait[]
  characters           CharacterSkill[]
  createdAt            DateTime         @default(now())
}

model BattleField {
  id          String                @id @default(cuid())
  name        String                @unique
  description String
  modifiers   BattleFieldModifier[]
  skills      Skill[]
  battles     Battle[]
  createdAt   DateTime              @default(now())
}

model Battle {
  id            String       @id @default(cuid())
  mode          BattleMode
  status        BattleStatus @default(COMPLETED)
  battleFieldId String
  winnerTeam    Int?
  totalTurns    Int          @default(0)
  maxTurns      Int?
  log           Json         @default("[]")
  sessionState  Json?
  teams         BattleTeam[]
  battleField   BattleField  @relation(fields: [battleFieldId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model BattleTeam {
  id           String              @id @default(cuid())
  battleId     String
  teamNumber   Int
  userId       String?
  battle       Battle              @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id])
  participants BattleParticipant[]
}

model BattleParticipant {
  id           String     @id @default(cuid())
  battleTeamId String
  characterId  String
  positionRow  Int
  positionCol  Int
  battleTeam   BattleTeam @relation(fields: [battleTeamId], references: [id], onDelete: Cascade)
  character    Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model BattleFieldModifier {
  id            String      @id @default(cuid())
  battleFieldId String
  traitId       String
  stat          StatType
  bonusType     BonusType
  bonusValue    Float
  battleField   BattleField @relation(fields: [battleFieldId], references: [id], onDelete: Cascade)
  trait         Trait       @relation(fields: [traitId], references: [id])
}

model Character {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  userId      String?

  ranking                Ranking @default(DISCRETO)
  maxRanking             Ranking
  level                  Int     @default(1)
  xp                     Int     @default(0)
  breakthroughAttempts   Int     @default(0)
  pendingSkillSelections Int     @default(0)

  baseHp  Int
  baseAtk Int
  baseDef Int
  baseSpd Int

  secondaryPowerId String?
  awakenedPowerId  String?
  powerId          String
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  traits           Trait[]
  skills           CharacterSkill[]
  battleParticipations BattleParticipant[]
  pendingSkillChoices  PendingSkillChoice[]

  createdAt      DateTime @default(now())
  power          Power    @relation("PrimaryPower", fields: [powerId], references: [id])
  secondaryPower Power?   @relation("SecondaryPower", fields: [secondaryPowerId], references: [id])
  awakenedPower  Power?   @relation("AwakenedPower", fields: [awakenedPowerId], references: [id])
}

model CharacterSkill {
  characterId String
  skillId     String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id])
  assignedAt  DateTime  @default(now())

  @@id([characterId, skillId])
}

model PendingSkillChoice {
  id             String    @id @default(cuid())
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  optionSkillIds String[]
  chosenSkillId  String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([characterId, resolvedAt])
}
